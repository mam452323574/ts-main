    {
      "parameters": {
        "jsCode": "const status = Number($json?.statusCode) || 0;\nconst ok = status >= 200 && status < 300;\nconst terminal_error = ok ? null : ($json?.error ? \"request_failed\" : `http_${status || \"unknown\"}`);\nconst result = { provider: \"deepseek\", ok, status, terminal_error, checked_at: new Date().toISOString() };\nconsole.log(\"[scan-provider-canary]\", result);\nreturn [{ json: result }];"

{
  "name": "coach-conversation (manual DeepSeek credential rebind required)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "coach-conversation",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "9a3b6b62-0001-4f1e-8000-00000000c001",
      "name": "Webhook Coach Conversation",
      "webhookId": "coach-conversation-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalize Coach Conversation Input\n// Accepts: { conversation_id, user_id, persona_key, locale, output_contract_version, persona: { tone_instructions, style_guide }, messages: [{ role, content }], user_context }\n// Produces:\n//   $json.persona_route                       — used by the persona switch\n//   $json.coach_conversation_system_prompt    — full system prompt for the chain\n//   $json.coach_conversation_chat_history     — array of { role, content } for assistant context\n//   $json.coach_conversation_user_text        — last user message text fed to the LLM\nconst PERSONA_TONES = {\n  gentle_supportive: 'Use a gentle, supportive, reassuring wellness coaching tone. Warm, practical, encouraging, non-judgmental.',\n  strict_tough: 'Use a strict, tough-love coaching tone. Direct, disciplined, accountability-focused.',\n  motivational_energetic: 'Use a motivational, energetic coaching tone. Upbeat, momentum-building, action-oriented.',\n  patient_calm: 'Use a patient, calm coaching tone. Steady, empathetic, low pressure.',\n  analytical_precise: 'Use an analytical, precise coaching tone. Clear, structured, evidence-minded.',\n  playful_light: 'Use a playful, light coaching tone. Witty, friendly, breezy while remaining useful and respectful.',\n};\n\nfunction asString(value) {\n  if (typeof value !== 'string') return '';\n  return value.trim();\n}\n\nfunction isRecord(value) {\n  return value !== null && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction clamp(text, max) {\n  const value = asString(text);\n  return value.length > max ? value.slice(0, max) : value;\n}\n\nconst inputItem = items[0] && items[0].json ? items[0].json : {};\nconst payload = isRecord(inputItem.payload) ? inputItem.payload : inputItem;\n\nconst personaKeyRaw = asString(payload.persona_key || (payload.persona && payload.persona.key));\nconst personaKey = PERSONA_TONES[personaKeyRaw] ? personaKeyRaw : 'gentle_supportive';\nconst locale = asString(payload.locale) || 'fr';\nconst conversationId = asString(payload.conversation_id);\nconst userId = asString(payload.user_id);\n\nconst messagesArrayRaw = Array.isArray(payload.messages) ? payload.messages : [];\nconst messages = [];\nfor (const message of messagesArrayRaw) {\n  if (!isRecord(message)) continue;\n  const role = asString(message.role);\n  const content = clamp(message.content, role === 'user' ? 2000 : 8000);\n  if (!content) continue;\n  if (role !== 'user' && role !== 'assistant' && role !== 'system') continue;\n  messages.push({ role, content });\n}\n\nif (messages.length === 0) {\n  throw new Error('coach_conversation_messages_missing');\n}\n\n// Build sliding window history (drop the last user message, fed separately as text).\nconst lastUserIndex = (() => {\n  for (let i = messages.length - 1; i >= 0; i -= 1) {\n    if (messages[i].role === 'user') return i;\n  }\n  return -1;\n})();\n\nif (lastUserIndex < 0) {\n  throw new Error('coach_conversation_last_user_missing');\n}\n\nconst lastUserText = messages[lastUserIndex].content;\nconst contextHistory = messages\n  .slice(Math.max(0, lastUserIndex - 11), lastUserIndex)\n  .map((entry) => ({ role: entry.role, content: entry.content }));\n\n// Optional user context: keep it small.\nconst userContext = isRecord(payload.user_context) ? payload.user_context : {};\nconst inferredPersona = isRecord(userContext.inferred_persona) ? userContext.inferred_persona : null;\nconst recentScanDigest = Array.isArray(userContext.recent_scan_digest)\n  ? userContext.recent_scan_digest.slice(0, 3)\n  : [];\n\nconst personaTone = PERSONA_TONES[personaKey];\nconst styleGuide = (isRecord(payload.persona) && isRecord(payload.persona.style_guide))\n  ? payload.persona.style_guide\n  : null;\n\nconst styleGuideText = styleGuide\n  ? `Style guide: opening=${asString(styleGuide.opening)}; cadence=${asString(styleGuide.cadence)}; avoid=${Array.isArray(styleGuide.avoid) ? styleGuide.avoid.join(', ') : ''}; emphasize=${Array.isArray(styleGuide.emphasize) ? styleGuide.emphasize.join(', ') : ''}.`\n  : '';\n\nconst systemPromptLines = [\n  'You are the user\\'s wellness Coach inside a mobile app. Reply in their language.',\n  `Tone: ${personaTone}`,\n  styleGuideText,\n  'Format constraints: plain text only (no Markdown headers, no JSON, no code fences). Maximum 4 short paragraphs or a tight bullet list. Always one concrete next step. Never give medical or psychological diagnoses; recommend a professional when in doubt.',\n  `Locale: ${locale}.`,\n  inferredPersona ? `User context (inferred): ${JSON.stringify(inferredPersona).slice(0, 1200)}` : '',\n  recentScanDigest.length > 0 ? `Recent scan digest: ${JSON.stringify(recentScanDigest).slice(0, 1200)}` : '',\n  `Conversation id: ${conversationId || '(unknown)'}.`,\n];\nconst systemPrompt = systemPromptLines.filter(Boolean).join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      persona_route: personaKey,\n      conversation_id: conversationId,\n      user_id: userId,\n      locale,\n      coach_conversation_system_prompt: systemPrompt,\n      coach_conversation_chat_history: contextHistory,\n      coach_conversation_user_text: lastUserText,\n      coach_conversation_total_messages: messages.length,\n      coach_conversation_metadata: {\n        persona_key: personaKey,\n        history_size: contextHistory.length,\n      },\n    },\n  },\n];"
      },
      "id": "9a3b6b62-0002-4f1e-8000-00000000c002",
      "name": "Normalize Coach Conversation Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-gentle", "leftValue": "={{ $json.persona_route }}", "rightValue": "gentle_supportive", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "gentle" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-strict", "leftValue": "={{ $json.persona_route }}", "rightValue": "strict_tough", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "strict" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-motivational", "leftValue": "={{ $json.persona_route }}", "rightValue": "motivational_energetic", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "motivational" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-calm", "leftValue": "={{ $json.persona_route }}", "rightValue": "patient_calm", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "calm" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-analytical", "leftValue": "={{ $json.persona_route }}", "rightValue": "analytical_precise", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "analytical" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "id": "rule-playful", "leftValue": "={{ $json.persona_route }}", "rightValue": "playful_light", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "playful" }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.3,
      "position": [520, 0],
      "id": "9a3b6b62-0003-4f1e-8000-00000000c003",
      "name": "Route Conversation Persona"
    },

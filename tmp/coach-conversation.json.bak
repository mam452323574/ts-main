    {
      "parameters": {
        "jsCode": "// Finalize Coach Conversation Output\n// Normalizes the LLM response into a single JSON contract for the Edge Function.\nfunction asString(value) {\n  if (typeof value === 'string') return value.trim();\n  if (value && typeof value === 'object' && typeof value.text === 'string') return value.text.trim();\n  if (value && typeof value === 'object' && typeof value.content === 'string') return value.content.trim();\n  return '';\n}\n\nconst incoming = items[0] && items[0].json ? items[0].json : {};\nlet content = asString(incoming.text);\nif (!content) content = asString(incoming.response);\nif (!content) content = asString(incoming.output);\nif (!content && incoming.choices && incoming.choices[0]) {\n  const choice = incoming.choices[0];\n  content = asString(choice.message ? choice.message.content : '');\n  if (!content) content = asString(choice.text);\n}\n\nif (!content) {\n  throw new Error('coach_conversation_empty_response');\n}\n\nconst metadata = (incoming.coach_conversation_metadata && typeof incoming.coach_conversation_metadata === 'object')\n  ? incoming.coach_conversation_metadata\n  : {};\n\nreturn [\n  {\n    json: {\n      success: true,\n      content,\n      role: 'assistant',\n      model: 'deepseek-v4-flash',\n      provider: 'n8n',\n      persona_key: metadata.persona_key || null,\n      conversation_id: incoming.conversation_id || null,\n      generated_at: new Date().toISOString(),\n    },\n  },\n];"
      },
      "id": "9a3b6b62-0070-4f1e-8000-00000000c070",
      "name": "Finalize Coach Conversation Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 0]
    },

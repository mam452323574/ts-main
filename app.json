{
  "expo": {
    "name": "SelfLens",
    "slug": "health-scan",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "selflens",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2A64"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.selflens.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-adaptive-monochrome.png",
        "backgroundColor": "#0D2A64"
      },
      "package": "com.selflens.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "runtimeVersion": "1.0.0"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SelfLens uses the camera only when you choose to take a photo for a wellness scan."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SelfLens uses your photo library only when you choose a profile photo or scan image.",
          "cameraPermission": "SelfLens uses the camera only when you choose to take a photo for a wellness scan.",
          "microphonePermission": "SelfLens uses the microphone only when you choose voice dictation in Coach."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SelfLens uses the microphone only when you choose voice dictation in Coach.",
          "speechRecognitionPermission": "SelfLens uses speech recognition only to transcribe your voice dictation in Coach.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2F66C5",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c05cea9-b48e-4c50-aba8-bdb9855c9cd1"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://supabase.basedjew.com",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgwMDcwOTA1LCJleHAiOjIwOTU0MzA5MDV9.DNcht8AWIXe3Uqgz3P3PmINu2JeYEfqt1jM8TxHa2Yk",
      "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_quwALTkmmGXdVTOTTvfVeQCoMJW",
      "EXPO_PUBLIC_APPLOVIN_SDK_KEY": "",
      "EXPO_PUBLIC_APPLOVIN_ANDROID_REWARDED": "",
      "EXPO_PUBLIC_APPLOVIN_IOS_REWARDED": ""
    },
    "owner": "malo6002",
    "updates": {
      "url": "https://u.expo.dev/5c05cea9-b48e-4c50-aba8-bdb9855c9cd1",
      "fallbackToCacheTimeout": 0
    }
  }
}

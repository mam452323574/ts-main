{
  "expo": {
    "name": "SelfLens",
    "slug": "health-scan",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "selflens",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A2B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.selflens.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1E3A2B"
      },
      "package": "com.selflens.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "runtimeVersion": "1.0.0"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SelfLens a besoin d'acceder a votre camera pour capturer des photos destinees a l'analyse sante."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SelfLens a besoin d'acceder a vos photos pour choisir une photo de profil.",
          "cameraPermission": "SelfLens a besoin d'acceder a votre camera pour capturer des photos destinees a l'analyse sante.",
          "microphonePermission": "SelfLens a besoin d'acceder a votre micro pour la dictee vocale dans la conversation avec ton coach."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SelfLens a besoin d'acceder a votre micro pour la dictee vocale dans la conversation avec ton coach.",
          "speechRecognitionPermission": "SelfLens utilise la reconnaissance vocale pour transcrire ce que tu dis dans la conversation avec ton coach.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E3A2B",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7622840244305747~9488642668",
          "iosAppId": "ca-app-pub-7622840244305747~8095669949",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "SelfLens utilise cet identifiant publicitaire pour vous proposer des publicites plus pertinentes. Vous pouvez refuser sans perdre aucune fonctionnalite."
        }
      ],
      [
